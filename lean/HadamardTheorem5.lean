import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Matrix.Block
import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Tactic.Abel
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith

/-!
# Goethals-Seidel constructions of Hadamard matrices

This file formalizes Theorems 3 and 5 of arXiv:2610.27175v1.

For the unbordered construction (Theorem 3), four ±1 vectors
`a, b, c, d : Fin m → ℤ` whose periodic autocorrelations sum to zero at every
nonzero shift yield a Hadamard matrix of order `4m`.

For the even-length bordered construction (Theorem 5):
Given `m > 0` and four ±1 vectors `a, b, c, d : Fin m → ℤ` with row sums `(2, 0, 0, 0)` and
periodic autocorrelation sum equal to `-4` for all nonzero shifts `s : Fin m`, the explicitly
constructed `(4m + 4) × (4m + 4)` bordered Goethals-Seidel matrix `H` has all entries in `{1, -1}`
and satisfies `H * Hᵀ = (4m + 4) • 1`.
-/

namespace HadamardTheorem5

open Matrix BigOperators

section CirculantAndBackDiag

variable {m : ℕ} [NeZero m]

/-- Circulant matrix generated by `v : Fin m → ℤ`: entry `(i, j)` is `v (j - i)`. -/
def circ (v : Fin m → ℤ) : Matrix (Fin m) (Fin m) ℤ :=
  Matrix.of fun i j => v (j - i)

/-- Back-diagonal involution matrix `R` on `Fin m`: entry `(i, j)` is `1` iff `i + j = 0`. -/
def backDiag (m : ℕ) [NeZero m] : Matrix (Fin m) (Fin m) ℤ :=
  Matrix.of fun i j => if i + j = 0 then 1 else 0

omit [NeZero m] in
@[simp]
lemma circ_apply (v : Fin m → ℤ) (i j : Fin m) : circ v i j = v (j - i) := rfl

lemma circ_transpose (v : Fin m → ℤ) : (circ v)ᵀ = circ (fun k => v (-k)) := by
  ext i j
  simp [circ, neg_sub]

lemma circ_mul_comm (u v : Fin m → ℤ) : circ u * circ v = circ v * circ u := by
  ext i j
  simp only [Matrix.mul_apply, circ_apply]
  have h := Equiv.sum_comp (Equiv.subLeft (i + j)) (fun k => v (k - i) * u (j - k))
  rw [← h]
  apply Finset.sum_congr rfl
  intro k _
  simp only [Equiv.subLeft_apply]
  have h1 : i + j - k - i = j - k := by abel
  have h2 : j - (i + j - k) = k - i := by abel
  rw [h1, h2, mul_comm]

lemma backDiag_transpose : (backDiag m)ᵀ = backDiag m := by
  ext i j
  simp [backDiag, add_comm]

lemma mul_backDiag_apply (M : Matrix (Fin m) (Fin m) ℤ) (i j : Fin m) :
    (M * backDiag m) i j = M i (-j) := by
  simp only [Matrix.mul_apply, backDiag, Matrix.of_apply]
  rw [Finset.sum_eq_single (-j)]
  · simp
  · intro k _ hk
    have : k + j ≠ 0 := by
      intro h
      exact hk (eq_neg_of_add_eq_zero_left h)
    simp [this]
  · simp

lemma backDiag_mul_apply (M : Matrix (Fin m) (Fin m) ℤ) (i j : Fin m) :
    (backDiag m * M) i j = M (-i) j := by
  simp only [Matrix.mul_apply, backDiag, Matrix.of_apply]
  rw [Finset.sum_eq_single (-i)]
  · simp
  · intro k _ hk
    have : i + k ≠ 0 := by
      intro h
      exact hk (eq_neg_of_add_eq_zero_right h)
    simp [this]
  · simp

lemma backDiag_mul_self : backDiag m * backDiag m = 1 := by
  ext i j
  rw [mul_backDiag_apply]
  simp only [backDiag, Matrix.of_apply, Matrix.one_apply]
  have h : i + -j = 0 ↔ i = j := by
    rw [← sub_eq_add_neg, sub_eq_zero]
  simp [h]

lemma mul_backDiag_mul_transpose (M N : Matrix (Fin m) (Fin m) ℤ) :
    (M * backDiag m) * (N * backDiag m)ᵀ = M * Nᵀ := by
  rw [Matrix.transpose_mul, backDiag_transpose, Matrix.mul_assoc,
      ← Matrix.mul_assoc (backDiag m), backDiag_mul_self, Matrix.one_mul]

lemma circ_mul_backDiag_transpose (v : Fin m → ℤ) :
    (circ v * backDiag m)ᵀ = circ v * backDiag m := by
  ext i j
  simp only [Matrix.transpose_apply, mul_backDiag_apply, circ_apply]
  congr 1
  abel

lemma circ_transpose_mul_backDiag_transpose (v : Fin m → ℤ) :
    ((circ v)ᵀ * backDiag m)ᵀ = (circ v)ᵀ * backDiag m := by
  rw [circ_transpose]
  exact circ_mul_backDiag_transpose _

lemma circ_mul_backDiag_eq_backDiag_mul_transpose (v : Fin m → ℤ) :
    circ v * backDiag m = backDiag m * (circ v)ᵀ := by
  ext i j
  simp only [mul_backDiag_apply, backDiag_mul_apply, Matrix.transpose_apply, circ_apply]
  congr 1
  abel

lemma circ_mul_circ_backDiag (u v : Fin m → ℤ) :
    circ u * (circ v * backDiag m) = (circ v * backDiag m) * (circ u)ᵀ := by
  rw [← Matrix.mul_assoc, circ_mul_comm u v, Matrix.mul_assoc,
      circ_mul_backDiag_eq_backDiag_mul_transpose, ← Matrix.mul_assoc]

lemma circ_transpose_mul_comm (u v : Fin m → ℤ) :
    (circ u)ᵀ * circ v = circ v * (circ u)ᵀ := by
  rw [circ_transpose]
  exact circ_mul_comm _ _

lemma circ_transpose_mul_transpose_comm (u v : Fin m → ℤ) :
    (circ u)ᵀ * (circ v)ᵀ = (circ v)ᵀ * (circ u)ᵀ := by
  rw [circ_transpose, circ_transpose]
  exact circ_mul_comm _ _

lemma circ_transpose_mul_self_comm (v : Fin m → ℤ) :
    (circ v)ᵀ * circ v = circ v * (circ v)ᵀ :=
  circ_transpose_mul_comm v v

lemma circ_mul_circ_transpose_backDiag (u v : Fin m → ℤ) :
    circ u * ((circ v)ᵀ * backDiag m) = ((circ v)ᵀ * backDiag m) * (circ u)ᵀ := by
  rw [circ_transpose]
  exact circ_mul_circ_backDiag u _

lemma sum_circ_row (v : Fin m → ℤ) (i : Fin m) :
    ∑ j : Fin m, circ v i j = ∑ k : Fin m, v k := by
  simp only [circ_apply]
  exact Equiv.sum_comp (Equiv.subRight i) v

lemma sum_circ_mul_backDiag_row (v : Fin m → ℤ) (i : Fin m) :
    ∑ j : Fin m, (circ v * backDiag m) i j = ∑ k : Fin m, v k := by
  simp only [mul_backDiag_apply, circ_apply]
  have h1 := Equiv.sum_comp (Equiv.neg (Fin m)) (fun j => v (j - i))
  have h2 := Equiv.sum_comp (Equiv.subRight i) v
  exact h1.trans h2

lemma sum_circ_transpose_mul_backDiag_row (v : Fin m → ℤ) (i : Fin m) :
    ∑ j : Fin m, ((circ v)ᵀ * backDiag m) i j = ∑ k : Fin m, v k := by
  rw [circ_transpose, sum_circ_mul_backDiag_row]
  exact Equiv.sum_comp (Equiv.neg (Fin m)) v

lemma circ_mul_transpose_apply (v : Fin m → ℤ) (i j : Fin m) :
    (circ v * (circ v)ᵀ) i j = ∑ k : Fin m, v k * v (k + (i - j)) := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, circ_apply]
  rw [← Equiv.sum_comp (Equiv.addRight i) (fun k => v (k - i) * v (k - j))]
  apply Finset.sum_congr rfl
  intro k _
  simp only [Equiv.coe_addRight]
  have h1 : k + i - i = k := by abel
  have h2 : k + i - j = k + (i - j) := by abel
  rw [h1, h2]

lemma pm_one_sq {x : ℤ} (hx : x = 1 ∨ x = -1) : x * x = 1 := by
  rcases hx with rfl | rfl <;> norm_num

lemma pm_one_neg {x : ℤ} (hx : x = 1 ∨ x = -1) : -x = 1 ∨ -x = -1 := by
  rcases hx with rfl | rfl <;> simp

end CirculantAndBackDiag

section BlockConstruction

variable {m : ℕ} [NeZero m]

/-- Top-left 4×4 border block `U`: `+1` on diagonal, `-1` off diagonal. -/
def U : Matrix (Fin 4) (Fin 4) ℤ :=
  Matrix.of fun r c => if r = c then 1 else -1

/-- Sign matrix for the top-right 4 × 4m border block `V`. -/
def V_sign : Fin 4 → Fin 4 → ℤ
  | 0, 0 => 1  | 0, 1 => 1  | 0, 2 => 1  | 0, 3 => 1
  | 1, 0 => 1  | 1, 1 => -1 | 1, 2 => 1  | 1, 3 => -1
  | 2, 0 => 1  | 2, 1 => -1 | 2, 2 => -1 | 2, 3 => 1
  | 3, 0 => 1  | 3, 1 => 1  | 3, 2 => -1 | 3, 3 => -1

/-- Sign matrix for the bottom-left 4m × 4 border block `W`. -/
def W_sign : Fin 4 → Fin 4 → ℤ
  | 0, 0 => 1  | 0, 1 => 1  | 0, 2 => 1  | 0, 3 => 1
  | 1, 0 => -1 | 1, 1 => 1  | 1, 2 => 1  | 1, 3 => -1
  | 2, 0 => -1 | 2, 1 => -1 | 2, 2 => 1  | 2, 3 => 1
  | 3, 0 => -1 | 3, 1 => 1  | 3, 2 => -1 | 3, 3 => 1

/-- Top-right 4 × 4m block `V`. -/
def V (m : ℕ) : Matrix (Fin 4) (Fin 4 × Fin m) ℤ :=
  Matrix.of fun r p => V_sign r p.1

/-- Bottom-left 4m × 4 block `W`. -/
def W (m : ℕ) : Matrix (Fin 4 × Fin m) (Fin 4) ℤ :=
  Matrix.of fun p c => W_sign p.1 c

/-- The 4×4 block entries of the Goethals-Seidel array. -/
def GS_block (a b c d : Fin m → ℤ) : Fin 4 → Fin 4 → Matrix (Fin m) (Fin m) ℤ
  | 0, 0 => circ a
  | 0, 1 => circ b * backDiag m
  | 0, 2 => circ c * backDiag m
  | 0, 3 => circ d * backDiag m
  | 1, 0 => -(circ b * backDiag m)
  | 1, 1 => circ a
  | 1, 2 => (circ d)ᵀ * backDiag m
  | 1, 3 => -((circ c)ᵀ * backDiag m)
  | 2, 0 => -(circ c * backDiag m)
  | 2, 1 => -((circ d)ᵀ * backDiag m)
  | 2, 2 => circ a
  | 2, 3 => (circ b)ᵀ * backDiag m
  | 3, 0 => -(circ d * backDiag m)
  | 3, 1 => (circ c)ᵀ * backDiag m
  | 3, 2 => -((circ b)ᵀ * backDiag m)
  | 3, 3 => circ a

/-- The 4m × 4m Goethals-Seidel matrix, used as the bottom-right block in Theorem 5. -/
def G (a b c d : Fin m → ℤ) : Matrix (Fin 4 × Fin m) (Fin 4 × Fin m) ℤ :=
  Matrix.of fun p q => GS_block a b c d p.1 q.1 p.2 q.2

/-- The bordered Goethals-Seidel matrix indexed by `Fin 4 ⊕ (Fin 4 × Fin m)`. -/
def H_block (a b c d : Fin m → ℤ) :
    Matrix (Fin 4 ⊕ (Fin 4 × Fin m)) (Fin 4 ⊕ (Fin 4 × Fin m)) ℤ :=
  Matrix.fromBlocks U (V m) (W m) (G a b c d)

/-- Explicit index equivalence `Fin (4 * m + 4) ≃ Fin 4 ⊕ (Fin 4 × Fin m)`:
indices `0..3` are the 4 border rows/columns, and indices `4..4m+3` are the 4 blocks of size `m`. -/
def idxEquiv (m : ℕ) : Fin (4 * m + 4) ≃ Fin 4 ⊕ (Fin 4 × Fin m) :=
  (finCongr (by omega : 4 * m + 4 = 4 + 4 * m)).trans <|
    finSumFinEquiv.symm.trans <|
      Equiv.sumCongr (Equiv.refl (Fin 4)) finProdFinEquiv.symm

/-- The explicit `(4m + 4) × (4m + 4)` bordered Goethals-Seidel matrix `H` from Theorem 5. -/
def H (a b c d : Fin m → ℤ) : Matrix (Fin (4 * m + 4)) (Fin (4 * m + 4)) ℤ :=
  Matrix.reindex (idxEquiv m).symm (idxEquiv m).symm (H_block a b c d)

private lemma U_mul_U_transpose : U * Uᵀ = (4 : ℤ) • (1 : Matrix (Fin 4) (Fin 4) ℤ) := by
  ext r c
  simp only [Matrix.mul_apply, Matrix.transpose_apply, U, Matrix.of_apply,
    Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, Fin.sum_univ_four]
  fin_cases r <;> fin_cases c <;> decide

omit [NeZero m] in
private lemma V_mul_V_transpose :
    V m * (V m)ᵀ = ((4 * m : ℤ) • (1 : Matrix (Fin 4) (Fin 4) ℤ)) := by
  ext r c
  simp only [Matrix.mul_apply, Matrix.transpose_apply, V, Matrix.of_apply,
    Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
  rw [Fintype.sum_prod_type]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Fin.sum_univ_four]
  fin_cases r <;> fin_cases c <;> simp [V_sign] <;> ring

omit [NeZero m] in
private lemma top_left_block :
    U * Uᵀ + V m * (V m)ᵀ = ((4 * m + 4 : ℤ) • (1 : Matrix (Fin 4) (Fin 4) ℤ)) := by
  rw [U_mul_U_transpose, V_mul_V_transpose, ← add_smul]
  congr 1
  ring

omit [NeZero m] in
private lemma U_mul_W_transpose (r c : Fin 4) (j : Fin m) :
    (U * (W m)ᵀ) r (c, j) = -2 * V_sign r c := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, U, W, Matrix.of_apply, Fin.sum_univ_four]
  fin_cases r <;> fin_cases c <;> decide

private lemma GS_block_row_sum {a b c d : Fin m → ℤ}
    (hsa : ∑ i : Fin m, a i = 2)
    (hsb : ∑ i : Fin m, b i = 0)
    (hsc : ∑ i : Fin m, c i = 0)
    (hsd : ∑ i : Fin m, d i = 0)
    (r k : Fin 4) (j : Fin m) :
    ∑ t : Fin m, GS_block a b c d r k j t = if r = k then 2 else 0 := by
  fin_cases r <;> fin_cases k <;>
    simp only [GS_block, Matrix.neg_apply, Finset.sum_neg_distrib,
      sum_circ_row, sum_circ_mul_backDiag_row, sum_circ_transpose_mul_backDiag_row,
      hsa, hsb, hsc, hsd, neg_zero] <;>
    decide

private lemma top_right_block {a b c d : Fin m → ℤ}
    (hsa : ∑ i : Fin m, a i = 2)
    (hsb : ∑ i : Fin m, b i = 0)
    (hsc : ∑ i : Fin m, c i = 0)
    (hsd : ∑ i : Fin m, d i = 0) :
    U * (W m)ᵀ + V m * (G a b c d)ᵀ = 0 := by
  ext r ⟨c', j⟩
  simp only [Matrix.add_apply, Matrix.zero_apply]
  rw [U_mul_W_transpose]
  have hVG : (V m * (G a b c d)ᵀ) r (c', j) = 2 * V_sign r c' := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply, V, G, Matrix.of_apply]
    rw [Fintype.sum_prod_type]
    have hpull : ∀ k : Fin 4,
        ∑ t : Fin m, V_sign r k * GS_block a b c d c' k j t =
        V_sign r k * ∑ t : Fin m, GS_block a b c d c' k j t := fun k =>
      (Finset.mul_sum _ _ _).symm
    simp_rw [hpull, GS_block_row_sum hsa hsb hsc hsd]
    simp [mul_comm]
  rw [hVG]
  ring

private lemma bottom_left_block {a b c d : Fin m → ℤ}
    (hsa : ∑ i : Fin m, a i = 2)
    (hsb : ∑ i : Fin m, b i = 0)
    (hsc : ∑ i : Fin m, c i = 0)
    (hsd : ∑ i : Fin m, d i = 0) :
    W m * Uᵀ + G a b c d * (V m)ᵀ = 0 := by
  have h := congr_arg Matrix.transpose (top_right_block hsa hsb hsc hsd)
  simpa [Matrix.transpose_add, Matrix.transpose_mul] using h

omit [NeZero m] in
private lemma W_mul_W_transpose_apply (r c : Fin 4) (i j : Fin m) :
    (W m * (W m)ᵀ) (r, i) (c, j) = if r = c then 4 else 0 := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, W, Matrix.of_apply, Fin.sum_univ_four]
  fin_cases r <;> fin_cases c <;> decide

private lemma G_mul_G_transpose_block (a b c d : Fin m → ℤ) (r c' : Fin 4) :
    ∑ k : Fin 4, GS_block a b c d r k * (GS_block a b c d c' k)ᵀ =
      if r = c' then
        circ a * (circ a)ᵀ + circ b * (circ b)ᵀ + circ c * (circ c)ᵀ + circ d * (circ d)ᵀ
      else 0 := by
  simp only [Fin.sum_univ_four]
  fin_cases r <;> fin_cases c' <;>
    simp only [GS_block, Matrix.transpose_neg,
      Matrix.mul_neg, Matrix.neg_mul, neg_neg,
      mul_backDiag_mul_transpose, Matrix.transpose_transpose,
      circ_transpose_mul_self_comm] <;>
    (try simp only [circ_mul_backDiag_transpose, circ_transpose_mul_backDiag_transpose])
  · -- (0, 0)
    simp only [ite_true]
  · -- (0, 1)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_backDiag a b, circ_mul_comm c d]; abel
  · -- (0, 2)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_backDiag a c, circ_mul_comm b d]; abel
  · -- (0, 3)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_backDiag a d, circ_mul_comm b c]; abel
  · -- (1, 0)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_backDiag a b, circ_transpose_mul_transpose_comm d c]; abel
  · -- (1, 1)
    simp only [ite_true]; abel
  · -- (1, 2)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_transpose_backDiag a d, circ_transpose_mul_comm c b]; abel
  · -- (1, 3)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_transpose_backDiag a c, circ_transpose_mul_comm d b]; abel
  · -- (2, 0)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_backDiag a c, circ_transpose_mul_transpose_comm d b]; abel
  · -- (2, 1)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_transpose_backDiag a d, circ_transpose_mul_comm b c]; abel
  · -- (2, 2)
    simp only [ite_true]; abel
  · -- (2, 3)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_transpose_backDiag a b, circ_transpose_mul_comm d c]; abel
  · -- (3, 0)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_backDiag a d, circ_transpose_mul_transpose_comm c b]; abel
  · -- (3, 1)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_transpose_backDiag a c, circ_transpose_mul_comm b d]; abel
  · -- (3, 2)
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by decide)), circ_mul_circ_transpose_backDiag a b, circ_transpose_mul_comm c d]; abel
  · -- (3, 3)
    simp only [ite_true]; abel

private lemma G_mul_G_transpose_apply (a b c d : Fin m → ℤ) (r c' : Fin 4) (i j : Fin m) :
    (G a b c d * (G a b c d)ᵀ) (r, i) (c', j) =
      if r = c' then
        (circ a * (circ a)ᵀ + circ b * (circ b)ᵀ + circ c * (circ c)ᵀ + circ d * (circ d)ᵀ) i j
      else 0 := by
  have hmul : (G a b c d * (G a b c d)ᵀ) (r, i) (c', j) =
      (∑ k : Fin 4, GS_block a b c d r k * (GS_block a b c d c' k)ᵀ) i j := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply, G, Matrix.of_apply, Matrix.sum_apply]
    rw [Fintype.sum_prod_type]
  rw [hmul, G_mul_G_transpose_block]
  split_ifs <;> rfl

private lemma circ_sum_autocorr {a b c d : Fin m → ℤ} {target : ℤ}
    (ha : ∀ i, a i = 1 ∨ a i = -1)
    (hb : ∀ i, b i = 1 ∨ b i = -1)
    (hc : ∀ i, c i = 1 ∨ c i = -1)
    (hd : ∀ i, d i = 1 ∨ d i = -1)
    (hauto : ∀ s : Fin m, s ≠ 0 →
      ∑ i : Fin m, (a i * a (i + s) + b i * b (i + s) + c i * c (i + s) + d i * d (i + s)) =
        target)
    (i j : Fin m) :
    (circ a * (circ a)ᵀ + circ b * (circ b)ᵀ + circ c * (circ c)ᵀ + circ d * (circ d)ᵀ) i j =
      if i = j then (4 * m : ℤ) else target := by
  simp only [Matrix.add_apply, circ_mul_transpose_apply]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  by_cases hij : i = j
  · subst hij
    simp only [sub_self, add_zero, ↓reduceIte]
    have hterm : ∀ k : Fin m, a k * a k + b k * b k + c k * c k + d k * d k = 4 := by
      intro k
      rw [pm_one_sq (ha k), pm_one_sq (hb k), pm_one_sq (hc k), pm_one_sq (hd k)]
      norm_num
    simp_rw [hterm]
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    ring
  · simp only [hij, ↓reduceIte]
    exact hauto (i - j) (sub_ne_zero.mpr hij)

private lemma bottom_right_block {a b c d : Fin m → ℤ}
    (ha : ∀ i, a i = 1 ∨ a i = -1)
    (hb : ∀ i, b i = 1 ∨ b i = -1)
    (hc : ∀ i, c i = 1 ∨ c i = -1)
    (hd : ∀ i, d i = 1 ∨ d i = -1)
    (hauto : ∀ s : Fin m, s ≠ 0 →
      ∑ i : Fin m, (a i * a (i + s) + b i * b (i + s) + c i * c (i + s) + d i * d (i + s)) = -4) :
    W m * (W m)ᵀ + G a b c d * (G a b c d)ᵀ =
      ((4 * m + 4 : ℤ) • (1 : Matrix (Fin 4 × Fin m) (Fin 4 × Fin m) ℤ)) := by
  ext ⟨r, i⟩ ⟨c', j⟩
  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, Prod.mk.injEq]
  rw [W_mul_W_transpose_apply, G_mul_G_transpose_apply, circ_sum_autocorr ha hb hc hd hauto]
  by_cases hrc : r = c' <;> by_cases hij : i = j <;> simp [hrc, hij] ; ring

private lemma G_entries {a b c d : Fin m → ℤ}
    (ha : ∀ i, a i = 1 ∨ a i = -1)
    (hb : ∀ i, b i = 1 ∨ b i = -1)
    (hc : ∀ i, c i = 1 ∨ c i = -1)
    (hd : ∀ i, d i = 1 ∨ d i = -1)
    (p q : Fin 4 × Fin m) :
    G a b c d p q = 1 ∨ G a b c d p q = -1 := by
  obtain ⟨r, i⟩ := p
  obtain ⟨c', j⟩ := q
  simp only [G, Matrix.of_apply]
  fin_cases r <;> fin_cases c' <;>
    simp only [GS_block, Matrix.neg_apply, mul_backDiag_apply,
      Matrix.transpose_apply, circ_apply]
  · exact ha _
  · exact hb _
  · exact hc _
  · exact hd _
  · exact pm_one_neg (hb _)
  · exact ha _
  · exact hd _
  · exact pm_one_neg (hc _)
  · exact pm_one_neg (hc _)
  · exact pm_one_neg (hd _)
  · exact ha _
  · exact hb _
  · exact pm_one_neg (hd _)
  · exact hc _
  · exact pm_one_neg (hb _)
  · exact ha _

private lemma H_block_entries {a b c d : Fin m → ℤ}
    (ha : ∀ i, a i = 1 ∨ a i = -1)
    (hb : ∀ i, b i = 1 ∨ b i = -1)
    (hc : ∀ i, c i = 1 ∨ c i = -1)
    (hd : ∀ i, d i = 1 ∨ d i = -1)
    (p q : Fin 4 ⊕ (Fin 4 × Fin m)) :
    H_block a b c d p q = 1 ∨ H_block a b c d p q = -1 := by
  cases p with
  | inl r =>
    cases q with
    | inl c' =>
      simp only [H_block, Matrix.fromBlocks_apply₁₁, U, Matrix.of_apply]
      split_ifs <;> simp
    | inr q =>
      simp only [H_block, Matrix.fromBlocks_apply₁₂, V, Matrix.of_apply]
      obtain ⟨c', j⟩ := q
      dsimp only
      fin_cases r <;> fin_cases c' <;> decide
  | inr p =>
    cases q with
    | inl c' =>
      simp only [H_block, Matrix.fromBlocks_apply₂₁, W, Matrix.of_apply]
      obtain ⟨r, i⟩ := p
      dsimp only
      fin_cases r <;> fin_cases c' <;> decide
    | inr q =>
      exact G_entries ha hb hc hd p q

private lemma H_block_mul_transpose {a b c d : Fin m → ℤ}
    (ha : ∀ i, a i = 1 ∨ a i = -1)
    (hb : ∀ i, b i = 1 ∨ b i = -1)
    (hc : ∀ i, c i = 1 ∨ c i = -1)
    (hd : ∀ i, d i = 1 ∨ d i = -1)
    (hsa : ∑ i : Fin m, a i = 2)
    (hsb : ∑ i : Fin m, b i = 0)
    (hsc : ∑ i : Fin m, c i = 0)
    (hsd : ∑ i : Fin m, d i = 0)
    (hauto : ∀ s : Fin m, s ≠ 0 →
      ∑ i : Fin m, (a i * a (i + s) + b i * b (i + s) + c i * c (i + s) + d i * d (i + s)) = -4) :
    H_block a b c d * (H_block a b c d)ᵀ =
      ((4 * m + 4 : ℤ) • (1 : Matrix (Fin 4 ⊕ (Fin 4 × Fin m)) (Fin 4 ⊕ (Fin 4 × Fin m)) ℤ)) := by
  unfold H_block
  rw [Matrix.fromBlocks_transpose, Matrix.fromBlocks_multiply,
      top_left_block, top_right_block hsa hsb hsc hsd,
      bottom_left_block hsa hsb hsc hsd, bottom_right_block ha hb hc hd hauto]
  rw [← Matrix.fromBlocks_one, Matrix.fromBlocks_smul]
  simp only [smul_zero]

end BlockConstruction

/-- The explicit `4m × 4m` unbordered Goethals-Seidel matrix. -/
def H_unbordered {m : ℕ} [NeZero m] (a b c d : Fin m → ℤ) :
    Matrix (Fin (4 * m)) (Fin (4 * m)) ℤ :=
  Matrix.reindex finProdFinEquiv finProdFinEquiv (G a b c d)

/-- **Theorem 3 (Goethals-Seidel Hadamard Matrix)**:
Four ±1 sequences whose periodic autocorrelations sum to zero at every nonzero shift
give a Hadamard matrix of order `4m`. -/
theorem goethals_seidel_hadamard
    {m : ℕ} [NeZero m]
    (a b c d : Fin m → ℤ)
    (ha : ∀ i, a i = 1 ∨ a i = -1)
    (hb : ∀ i, b i = 1 ∨ b i = -1)
    (hc : ∀ i, c i = 1 ∨ c i = -1)
    (hd : ∀ i, d i = 1 ∨ d i = -1)
    (hauto : ∀ s : Fin m, s ≠ 0 →
      ∑ i : Fin m, (a i * a (i + s) + b i * b (i + s) + c i * c (i + s) + d i * d (i + s)) =
        0) :
    (∀ i j, H_unbordered a b c d i j = 1 ∨ H_unbordered a b c d i j = -1) ∧
    H_unbordered a b c d * (H_unbordered a b c d)ᵀ =
      ((4 * m : ℤ) • (1 : Matrix (Fin (4 * m)) (Fin (4 * m)) ℤ)) := by
  constructor
  · intro i j
    exact G_entries ha hb hc hd (finProdFinEquiv.symm i) (finProdFinEquiv.symm j)
  · have hgram : G a b c d * (G a b c d)ᵀ =
        ((4 * m : ℤ) • (1 : Matrix (Fin 4 × Fin m) (Fin 4 × Fin m) ℤ)) := by
      ext ⟨r, i⟩ ⟨c', j⟩
      simp only [Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, Prod.mk.injEq]
      rw [G_mul_G_transpose_apply, circ_sum_autocorr ha hb hc hd hauto]
      by_cases hrc : r = c' <;> by_cases hij : i = j <;> simp [hrc, hij]
    have hmul : H_unbordered a b c d * (H_unbordered a b c d)ᵀ =
        Matrix.reindex finProdFinEquiv finProdFinEquiv (G a b c d * (G a b c d)ᵀ) := by
      ext i j
      simp only [H_unbordered, Matrix.reindex_apply, Matrix.submatrix_apply,
        Matrix.mul_apply, Matrix.transpose_apply]
      exact Equiv.sum_comp finProdFinEquiv.symm
        (fun k => G a b c d (finProdFinEquiv.symm i) k * G a b c d (finProdFinEquiv.symm j) k)
    rw [hmul, hgram]
    ext i j
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.smul_apply,
      Matrix.one_apply, smul_eq_mul, EmbeddingLike.apply_eq_iff_eq]

/-- **Theorem 5 (Bordered Goethals-Seidel Hadamard Matrix)**:
Given `m > 0` (`[NeZero m]`) and four ±1 vectors `a, b, c, d : Fin m → ℤ` with row sums
`(2, 0, 0, 0)` and periodic autocorrelation sum equal to `-4` for all nonzero shifts `s : Fin m`,
the explicitly constructed `(4m + 4) × (4m + 4)` matrix `H a b c d` has entries in `{1, -1}` and
satisfies `H * Hᵀ = (4m + 4) • 1`. -/
theorem bordered_goethals_seidel_hadamard
    {m : ℕ} [NeZero m]
    (a b c d : Fin m → ℤ)
    (ha : ∀ i, a i = 1 ∨ a i = -1)
    (hb : ∀ i, b i = 1 ∨ b i = -1)
    (hc : ∀ i, c i = 1 ∨ c i = -1)
    (hd : ∀ i, d i = 1 ∨ d i = -1)
    (hsa : ∑ i : Fin m, a i = 2)
    (hsb : ∑ i : Fin m, b i = 0)
    (hsc : ∑ i : Fin m, c i = 0)
    (hsd : ∑ i : Fin m, d i = 0)
    (hauto : ∀ s : Fin m, s ≠ 0 →
      ∑ i : Fin m, (a i * a (i + s) + b i * b (i + s) + c i * c (i + s) + d i * d (i + s)) = -4) :
    (∀ i j, H a b c d i j = 1 ∨ H a b c d i j = -1) ∧
    H a b c d * (H a b c d)ᵀ =
      ((4 * m + 4 : ℤ) • (1 : Matrix (Fin (4 * m + 4)) (Fin (4 * m + 4)) ℤ)) := by
  constructor
  · intro i j
    exact H_block_entries ha hb hc hd (idxEquiv m i) (idxEquiv m j)
  · have hmul : H a b c d * (H a b c d)ᵀ =
        Matrix.reindex (idxEquiv m).symm (idxEquiv m).symm
          (H_block a b c d * (H_block a b c d)ᵀ) := by
      ext i j
      simp only [H, Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.mul_apply,
        Matrix.transpose_apply, Equiv.symm_symm]
      exact Equiv.sum_comp (idxEquiv m)
        (fun k => H_block a b c d (idxEquiv m i) k * H_block a b c d (idxEquiv m j) k)
    rw [hmul, H_block_mul_transpose ha hb hc hd hsa hsb hsc hsd hauto]
    ext i j
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.smul_apply, Matrix.one_apply,
      smul_eq_mul, Equiv.symm_symm, EmbeddingLike.apply_eq_iff_eq]

/-- A concrete unbordered witness, checked by kernel reduction. -/
theorem hadamard_order_twelve :
    ∃ M : Matrix (Fin 12) (Fin 12) ℤ,
      (∀ i j, M i j = 1 ∨ M i j = -1) ∧
      M * Mᵀ = (12 : ℤ) • (1 : Matrix (Fin 12) (Fin 12) ℤ) := by
  let a : Fin 3 → ℤ := fun _ => 1
  let b : Fin 3 → ℤ := fun i => if i = 0 then -1 else 1
  refine ⟨H_unbordered a b b b, ?_⟩
  refine goethals_seidel_hadamard a b b b ?_ ?_ ?_ ?_ ?_
  · intro i
    exact Or.inl rfl
  · intro i
    fin_cases i <;> decide +revert
  · intro i
    fin_cases i <;> decide +revert
  · intro i
    fin_cases i <;> decide +revert
  · intro s
    fin_cases s <;> decide +revert

end HadamardTheorem5
